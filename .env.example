# Environment variables for the DOCKER setup (docker compose reads this file).
#
# If you installed the `trovia` command, you do not need this file: run `trovia config` instead, which
# stores the same settings in a per-user config file. Environment variables override that file.
# Every setting name works here in capitals; see docs/configuration.md for the full list.

# --- Search providers ---
# Leave a key blank to skip that provider. With no keys, DuckDuckGo (keyless) is used.
BRAVE_API_KEY=
SERPER_API_KEY=
PROVIDER_ORDER=brave,serper,searxng,ddgs   # ddgs = DuckDuckGo, no key needed
BRAVE_MONTHLY_LIMIT=950                    # stop before the monthly credit (~1,000 queries) runs out

# --- Optional, advanced: self-hosted SearXNG (docker compose --profile searxng up -d) ---
#   with the API in Docker:     SEARXNG_URL=http://searxng:8080/search
#   with the API run locally:   SEARXNG_URL=http://localhost:8080/search
SEARXNG_URL=
SEARXNG_SECRET=                            # only for the SearXNG container: python -c "import secrets;print(secrets.token_hex(32))"

# --- Page extraction ---
JINA_API_KEY=                              # optional; blank = about 20 requests/min, free key = about 500/min
TIER1_TIMEOUT_SEC=5
TIER2_TIMEOUT_SEC=10
GLOBAL_SCRAPE_TIMEOUT_SEC=20

# --- Your defaults for every search (the recommended values) ---
TOP_K_CHUNKS=6                             # advanced searches return twice this many
MAX_CHUNKS_TO_RERANK=300                   # 0 = score every candidate
MAX_CHUNKS_PER_URL=2

# --- Reranker and cache ---
RERANK_MODEL=ms-marco-TinyBERT-L-2-v2      # ms-marco-MiniLM-L-12-v2 is far slower on CPU
SERP_CACHE_TTL_SEC=3600
URL_CACHE_TTL_SEC=86400
WARMUP=true
